// Zentinelsec agent test config (localhost, gRPC)
system {
    worker-threads 0
    max-connections 10000
}

listeners {
    listener "http" {
        address "127.0.0.1:18081"
        protocol "http"
        request-timeout-secs 60
    }
}

agents {
    agent "zentinelsec" {
        grpc address="http://127.0.0.1:50051"
        timeout-ms 5000
        failure-mode "closed"
        max-request-body-bytes 1048576
    }
}

filters {
    filter "zentinelsec-filter" {
        type "agent"
        agent "zentinelsec"
        timeout-ms 5000
        failure-mode "closed"
        inspect-body #true
        max-body-bytes 1048576
    }
}

routes {
    route "health" {
        priority 100
        matches {
            path "/health"
        }
        upstream "backend"
    }

    route "protected" {
        priority 1
        matches {
            path-prefix "/"
        }
        upstream "backend"
        filters "zentinelsec-filter"
    }
}

upstreams {
    upstream "backend" {
        target "127.0.0.1:19090" weight=1
        load-balancing "round_robin"
    }
}

observability {
    logging {
        level "warn"
        format "json"
    }
}
